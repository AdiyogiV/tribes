{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run on iPhone",
            "type": "shell",
            "command": ".vscode/run_on_iphone.sh",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "new"
            }
        },
        {
            "label": "Run on Chrome",
            "type": "shell",
            "command": "flutter run -d chrome --web-port=8000 lib/main_web.dart",
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "new"
            }
        }
    ]
}