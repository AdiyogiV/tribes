{
    "name": "aurafarm-tribes-functions",
    "version": "1.0.0",
    "description": "Firebase Cloud Functions for Aurogram Tribes app",
    "main": "index.js",
    "type": "module",
    "engines": {
        "node": "22"
    },
    "scripts": {
        "serve": "firebase emulators:start --only functions",
        "shell": "firebase functions:shell",
        "start": "npm run shell",
        "deploy": "bash scripts/deploy.sh",
        "deploy:all": "firebase deploy --only functions --force",
        "deploy:list": "bash scripts/deploy.sh --list",
        "deploy:dry": "bash scripts/deploy.sh --dry-run",
        "deploy:gateways": "bash scripts/deploy.sh gateways",
        "deploy:workers": "bash scripts/deploy.sh workers",
        "deploy:triggers-content": "bash scripts/deploy.sh triggers-content",
        "deploy:triggers-engagement": "bash scripts/deploy.sh triggers-engagement",
        "deploy:triggers-unique": "bash scripts/deploy.sh triggers-unique",
        "deploy:standalone": "bash scripts/deploy.sh standalone",
        "logs": "firebase functions:log",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "test": "npm run test:rules && npm run test:reposts",
        "test:rules": "node --test tests/firestore.rules.test.js",
        "test:reposts": "node tests/test_reposts_final.js && node tests/test_reposts_cascade.js && node tests/test_reposts_helpers.js && node tests/test_reposts_edge_cases.js",
        "test:all": "node tests/test_all.js",
        "audit": "npm audit",
        "audit:fix": "npm audit fix",
        "predeploy": "npm run lint",
        "check": "npm run lint && npm run audit"
    },
    "dependencies": {
        "@google-cloud/vertexai": "^1.12.0",
        "@google/generative-ai": "^0.21.0",
        "agora-token": "^2.0.5",
        "firebase-admin": "^12.7.0",
        "firebase-functions": "^7.0.3",
        "jsonwebtoken": "^9.0.2",
        "luxon": "^3.5.0",
        "tz-lookup": "^6.1.25",
        "zod": "^3.25.76"
    },
    "devDependencies": {
        "@firebase/rules-unit-testing": "^5.0.0",
        "eslint": "^8.57.0",
        "eslint-config-google": "^0.14.0"
    },
    "private": true
}
